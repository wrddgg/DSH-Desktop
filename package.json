{
  "name": "dsh-desktop",
  "version": "1.1.0",
  "description": "Windows desktop shell for the official DeepSeek Harness",
  "private": true,
  "license": "MIT",
  "author": "wrddgg",
  "main": "dist/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-plugins.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "assets": "node scripts/generate-icon.cjs",
    "pack": "npm run build && npm run assets && npm run prepare:runtime && npm run audit:runtime -- runtime-resources/node_modules && electron-builder --win --dir && npm run audit:runtime && npm run smoke:runtime",
    "dist": "npm run build && npm run assets && npm run prepare:runtime && npm run audit:runtime -- runtime-resources/node_modules && electron-builder --win nsis && npm run audit:runtime && npm run smoke:runtime",
    "dist:ci": "npm run build && npm run assets && npm run prepare:runtime && npm run audit:runtime -- runtime-resources/node_modules && electron-builder --win nsis --publish never && npm run audit:runtime && npm run smoke:runtime"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "overrides": {
    "@deepseek-ai/dsh-web-frontend": {
      "@deepseek-ai/dsh-client-web": "$@deepseek-ai/dsh-client-web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-client-web": "file:packages/dsh-client-web-stub",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@types/node": "24.10.1",
    "@koromix/koffi-win32-x64": "3.1.5",
    "@wrddgg/dsh-desktop-plugin": "file:packages/dsh-desktop-plugin",
    "@wrddgg/dsh-desktop-file-ref": "file:packages/dsh-desktop-file-ref",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "io.github.wrddgg.dshdesktop",
    "productName": "DSH Desktop",
    "copyright": "Copyright © 2026 wrddgg",
    "artifactName": "DSH-Desktop-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.svg",
      "package.json",
      "compatibility.json"
    ],
    "extraResources": [
      {
        "from": "packages/dsh-desktop-plugin",
        "to": "dsh-desktop-plugin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/dsh-desktop-file-ref",
        "to": "dsh-desktop-file-ref",
        "filter": [
          "package.json",
          "cordis.patch.yml",
          "lib/**/*.js"
        ]
      },
      {
        "from": "runtime-resources/node_modules",
        "to": "dsh-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/*.dll"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wrddgg",
        "repo": "DSH-Desktop",
        "releaseType": "release"
      }
    ]
  }
}
