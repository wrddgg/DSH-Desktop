{
  "version": 1,
  "plugins": [
    {
      "id": "@wrddgg/dsh-desktop-plugin",
      "packageDir": "packages/dsh-desktop-plugin",
      "clientEntry": null,
      "clientBundle": "lib/client.js",
      "description": "Update UI + read-only diff overlay (hand-written client bundle)"
    },
    {
      "id": "@wrddgg/dsh-desktop-file-ref",
      "packageDir": "packages/dsh-desktop-file-ref",
      "clientEntry": "src/client.tsx",
      "clientBundle": "lib/client.js",
      "description": "Codex-style drag & drop file references and @file search",
      "bridge": ["fs", "dialog"]
    },
    {
      "id": "@wrddgg/dsh-desktop-workbench",
      "packageDir": "packages/dsh-desktop-workbench",
      "clientEntry": "src/client.tsx",
      "clientBundle": "lib/client.js",
      "description": "Workbench panel with Files / Git / Terminal tabs",
      "bridge": ["fs", "dialog", "git", "pty"]
    },
    {
      "id": "@wrddgg/dsh-desktop-pwsh",
      "packageDir": "packages/dsh-desktop-pwsh",
      "clientEntry": null,
      "clientBundle": null,
      "description": "Electron-safe PowerShell executor (host-only plugin, replaces official pwsh-sandbox)"
    }
  ]
}
