{
  "name": "@wrddgg/dsh-desktop-pwsh",
  "version": "0.1.0",
  "description": "Electron-safe PowerShell executor for DSH Desktop: official pwsh sandbox semantics outside Electron, ACL runner bypass inside it (0xC0000142)",
